@page "/"
@inject SlickSysDev.Admin.Services.CrmService Crm

<PageTitle>SlickSys CRM</PageTitle>

<h1>Field Service CRM Command Center</h1>
<p class="lead">Built for SMB operators managing scheduling, estimating, dispatch, and accounting in one place.</p>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="h6 text-muted">Today's Appointments</h2>
                <p class="display-6">@Crm.Appointments.Count(a => a.Date == DateOnly.FromDateTime(DateTime.Today))</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="h6 text-muted">Revenue (MTD)</h2>
                <p class="display-6">@Crm.TotalRevenue.ToString("C0")</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="h6 text-muted">Net Income</h2>
                <p class="display-6">@Crm.NetIncome.ToString("C0")</p>
            </div>
        </div>
    </div>
</div>

<div class="alert alert-primary">
    <strong>What's special:</strong> Multi-modal visual estimator + conversational voice dispatcher with real-time scheduling logic.
</div>
