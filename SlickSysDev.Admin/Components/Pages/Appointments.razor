@page "/appointments"
@inject SlickSysDev.Admin.Services.CrmService Crm

<PageTitle>Appointments</PageTitle>

<h1>Appointments</h1>

<table class="table table-striped table-sm">
    <thead>
    <tr>
        <th>Date</th>
        <th>Time</th>
        <th>Customer</th>
        <th>Vertical</th>
        <th>Priority</th>
        <th>Duration</th>
        <th>Quote</th>
        <th>Source</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Crm.Appointments)
    {
        <tr>
            <td>@item.Date.ToString("MMM dd")</td>
            <td>@item.Start.ToString("h:mm tt")</td>
            <td>@item.Customer</td>
            <td>@item.Vertical</td>
            <td><span class="badge @(item.Priority == SlickSysDev.Admin.Domain.DispatchPriority.Emergency ? "text-bg-danger" : "text-bg-secondary")">@item.Priority</span></td>
            <td>@item.DurationMinutes min</td>
            <td>@item.Quote.ToString("C")</td>
            <td>@item.Source</td>
        </tr>
    }
    </tbody>
</table>
